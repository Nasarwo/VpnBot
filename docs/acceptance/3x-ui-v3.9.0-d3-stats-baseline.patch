diff --git a/internal/web/service/xray_traffic.go b/internal/web/service/xray_traffic.go
new file mode 100644
index 0000000..b2b4c00
--- /dev/null
+++ b/internal/web/service/xray_traffic.go
@@ -0,0 +1,52 @@
+package service
+
+import (
+	"fmt"
+	"maps"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/web/service/outbound"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+
+	"gorm.io/gorm"
+)
+
+// collectXrayTrafficLocked samples and durably commits one process's deltas.
+// The caller holds the lifecycle lock through sampling, commit and baseline
+// advancement. Runtime maintenance is deliberately excluded: it can itself
+// request a restart and belongs to the traffic job after this returns.
+func (s *XrayService) collectXrayTrafficLocked(process *xray.Process) ([]*xray.Traffic, []*xray.ClientTraffic, error) {
+	api := xray.XrayAPI{StatsLastValues: maps.Clone(process.StatsBaseline())}
+	if err := api.Init(process.GetAPIPort()); err != nil {
+		return nil, nil, err
+	}
+	defer api.Close()
+	traffics, clients, err := api.GetTraffic()
+	if err != nil {
+		return nil, nil, err
+	}
+	var outboundService outbound.OutboundService
+	err = runSerializedTx(func(tx *gorm.DB) error {
+		if err := s.inboundService.addInboundTraffic(tx, traffics); err != nil {
+			return err
+		}
+		if err := s.inboundService.addClientTraffic(tx, clients); err != nil {
+			return err
+		}
+		return outboundService.AddTrafficTx(tx, traffics)
+	})
+	if err != nil {
+		// Neither the core counters nor the committed baseline have changed:
+		// the next poll can retry the whole delta without recounting a partial tx.
+		return nil, nil, fmt.Errorf("persist xray traffic: %w", err)
+	}
+	process.SetStatsBaseline(api.StatsLastValues)
+	return traffics, clients, nil
+}
+
+func (s *XrayService) flushXrayTrafficLocked(process *xray.Process) error {
+	_, _, err := s.collectXrayTrafficLocked(process)
+	if err != nil {
+		return fmt.Errorf("final xray traffic collection failed: %w", err)
+	}
+	return nil
+}
