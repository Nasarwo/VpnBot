+// TestGetTrafficCountsFromEmptyKnownBaseline is the regression for the first
+// traffic after a core (re)start being dropped: the panel started that core, so
+// its counters began at zero and an empty, non-nil baseline counts every byte.
+func TestGetTrafficCountsFromEmptyKnownBaseline(t *testing.T) {
+	api := startFakeStats(t, [][]*statsService.Stat{
+		{stat("user>>>alice>>>traffic>>>downlink", 8388608)},
+	})
+	api.StatsLastValues = map[string]int64{}
+
+	_, clients, err := api.GetTraffic()
+	if err != nil {
