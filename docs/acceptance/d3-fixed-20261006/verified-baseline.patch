+		t.Fatalf("first poll of a fresh core reported %+v, want down=8388608", alice)
+	}
+}
+
+// TestGetTrafficSharedBaselineDoesNotRecount pins the panel-only restart: a new
+// poller that inherits the core's baseline reports only what accrued after it.
+func TestGetTrafficSharedBaselineDoesNotRecount(t *testing.T) {
+	rounds := [][]*statsService.Stat{
+		{stat("user>>>alice>>>traffic>>>downlink", 1000)},
+		{stat("user>>>alice>>>traffic>>>downlink", 1500)},
+	}
+	first := startFakeStats(t, rounds[:1])
+	first.StatsLastValues = map[string]int64{}
+	if _, _, err := first.GetTraffic(); err != nil {
+		t.Fatalf("GetTraffic: %v", err)
+	}
+
+	second := startFakeStats(t, rounds[1:])
+	second.StatsLastValues = first.StatsLastValues
+	_, clients, err := second.GetTraffic()
+	if err != nil {
+		t.Fatalf("GetTraffic: %v", err)
+	}
+	alice := clientTrafficByEmail(t, clients)["alice"]
+	if alice == nil || alice.Down != 500 {
+		t.Fatalf("inherited baseline reported %+v, want down=500", alice)
+	}
+}
diff --git a/internal/xray/process.go b/internal/xray/process.go
index a7f0691..c924d0f 100644
--- a/internal/xray/process.go
+++ b/internal/xray/process.go
@@ -189,6 +189,16 @@ type process struct {
 	// lazily by the first caller.
 	onlineAPISupport atomic.Int32
 
+	// statsBaseline holds the stats counter values the traffic poll has already
+	// accounted for on this core. It lives with the process for the same reason
+	// as onlineAPISupport: every restart creates a new process whose counters
+	// start at zero, so its baseline starts empty and every byte counts, while
+	// a panel-only restart (SIGHUP) keeps polling the same core from where the
+	// previous poll left off. Only the traffic job uses it, and cron never runs
+	// that job concurrently with itself.
+	statsBaselineMu sync.Mutex
+	statsBaseline   map[string]int64
+
 	config     *Config
 	configPath string // if set, use this path instead of GetConfigPath() and remove on Stop
 	logWriter  *LogWriter
@@ -221,6 +231,25 @@ func (p *process) SetOnlineAPISupport(v OnlineAPISupport) {
 	p.onlineAPISupport.Store(int32(v))
 }
 
+// StatsBaseline returns the counter values already accounted for on this
+// process. The map is never nil: an empty one means nothing has been polled
+// yet, and since the panel started this core every counter began at zero.
+func (p *process) StatsBaseline() map[string]int64 {
+	p.statsBaselineMu.Lock()
+	defer p.statsBaselineMu.Unlock()
+	if p.statsBaseline == nil {
+		p.statsBaseline = make(map[string]int64)
+	}
+	return p.statsBaseline
+}
+
+// SetStatsBaseline stores the counter values accounted for by the latest poll.
+func (p *process) SetStatsBaseline(values map[string]int64) {
+	p.statsBaselineMu.Lock()
+	defer p.statsBaselineMu.Unlock()
+	p.statsBaseline = values
+}
