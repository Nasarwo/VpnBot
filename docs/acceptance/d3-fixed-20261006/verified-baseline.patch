--- /dev/null
+++ b/internal/web/service/xray_traffic_lifecycle_test.go
@@ -0,0 +1,39 @@
+package service
+
+import (
+	"testing"
+	"time"
+)
+
+// A traffic query must not reach the API while RestartXray/StopXray holds
+// the lifecycle lock: the same API port may already belong to a new core.
+func TestGetXrayTrafficWaitsForLifecycleOperation(t *testing.T) {
+	lock.Lock()
+	locked := true
+	defer func() {
+		if locked {
+			lock.Unlock()
+		}
+	}()
+	started := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		close(started)
+		service := XrayService{}
+		_, _, _ = service.GetXrayTraffic()
+		close(done)
+	}()
+	<-started
+	select {
+	case <-done:
+		t.Fatal("traffic query bypassed the lifecycle lock")
+	case <-time.After(50 * time.Millisecond):
+	}
+	lock.Unlock()
+	locked = false
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("traffic query did not resume after lifecycle operation")
+	}
+}
