 	xrayForceStopTimeout    = 2 * time.Second
diff --git a/internal/xray/process_stats_baseline_test.go b/internal/xray/process_stats_baseline_test.go
new file mode 100644
index 0000000..bab9b07
--- /dev/null
+++ b/internal/xray/process_stats_baseline_test.go
@@ -0,0 +1,23 @@
+package xray
+
+import "testing"
+
+// TestStatsBaselineBelongsToProcess: a restarted core is a new process with an
+// empty baseline, while the old process keeps its own.
+func TestStatsBaselineBelongsToProcess(t *testing.T) {
+	old := NewProcess(&Config{})
+	baseline := old.StatsBaseline()
+	if baseline == nil || len(baseline) != 0 {
+		t.Fatalf("new process baseline = %v, want empty non-nil map", baseline)
+	}
+	baseline["user>>>alice>>>traffic>>>downlink"] = 8388608
+	old.SetStatsBaseline(baseline)
+
+	restarted := NewProcess(&Config{})
+	if got := restarted.StatsBaseline(); len(got) != 0 {
+		t.Fatalf("restarted process inherited baseline %v", got)
+	}
+	if got := old.StatsBaseline()["user>>>alice>>>traffic>>>downlink"]; got != 8388608 {
+		t.Fatalf("old process baseline = %d, want 8388608", got)
+	}
+}
